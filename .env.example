# GEMINI_API_KEY: Optional if using Gemini models
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Required for OpenRouter LLM orchestration (Bulk classifier & Evaluator models).
# Security Best Practice: Never hardcode or pass directly to the client bundle.
# Keep strictly server-side in environment variables or cloud secrets.
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key"

# OPENROUTER_BASE_URL: Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Fast/Bulk Classification & Extraction Model (Cost-effective, low latency)
OPENROUTER_MODEL_FAST="google/gemini-2.5-flash"

# Deep Judgment, Synthesis & Evaluator Model (High reasoning, strict audit)
OPENROUTER_MODEL_JUDGE="anthropic/claude-3.5-sonnet"

# LOG_LEVEL: debug | info | warn | error
LOG_LEVEL="info"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
